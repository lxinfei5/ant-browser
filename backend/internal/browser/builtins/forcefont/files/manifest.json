{
  "manifest_version": 3,
  "name": "强制字体（Monaco + 95% 微软雅黑）",
  "version": "3.1.2",
  "description": "使用 Monaco + 95% 微软雅黑字体链，并尽量避免破坏网页图标字体",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.seedr.cc/*",
        "*://console.cloud.google.com/cloudshell*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
