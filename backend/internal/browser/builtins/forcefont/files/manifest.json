{
  "manifest_version": 3,
  "name": "Force Font",
  "version": "4.0.0",
  "description": "Force Font — 强制网页使用 Monaco + 95% 微软雅黑字体链，智能避让图标字体与代码块",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.seedr.cc/*",
        "*://console.cloud.google.com/cloudshell*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
